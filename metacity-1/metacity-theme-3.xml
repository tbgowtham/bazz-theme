<?xml version="1.0"?>
<metacity_theme>
<info>
  <name>macOS-Cupertino</name>
  <author>MR_Gray</author>
  <copyright>GPL</copyright>
  <date>2026</date>
  <description>macOS Sonoma &amp; Sequoia Luxury Window Decoration with Authentic Traffic Lights and Catppuccin Macchiato Tones</description>
</info>

<!-- ::: CONSTANTS ::: -->
<constant name="C_title_focused" value="#F5F5F7" />
<constant name="C_title_unfocused" value="#8087A2" />

<constant name="C_wm_bg" value="#24273A" />
<constant name="C_wm_bg_unfocused" value="#181825" />
<constant name="C_wm_border" value="#363A4F" />
<constant name="C_wm_border_unfocused" value="#1E2030" />

<!-- macOS Traffic Light Colors -->
<constant name="C_btn_close" value="#FF5F56" />
<constant name="C_btn_close_border" value="#E0443E" />
<constant name="C_btn_close_hover" value="#FF3B30" />

<constant name="C_btn_min" value="#FFBD2E" />
<constant name="C_btn_min_border" value="#DEA123" />
<constant name="C_btn_min_hover" value="#FF9500" />

<constant name="C_btn_max" value="#27C93F" />
<constant name="C_btn_max_border" value="#1AAB29" />
<constant name="C_btn_max_hover" value="#34C759" />

<constant name="C_btn_unfocused" value="#48484A" />
<constant name="C_btn_unfocused_border" value="#3A3A3C" />

<!-- ::: GEOMETRY ::: -->
<frame_geometry name="normal" title_scale="medium" rounded_top_left="14" rounded_top_right="14">
  <distance name="left_width" value="1" />
  <distance name="right_width" value="1" />
  <distance name="bottom_height" value="1" />
  <distance name="left_titlebar_edge" value="10" />
  <distance name="right_titlebar_edge" value="10" />
  <distance name="top_titlebar_edge" value="4" />
  <distance name="bottom_titlebar_edge" value="4" />
  <distance name="title_vertical_pad" value="8" />
  <border name="title_border" left="10" right="10" top="4" bottom="4" />
  <border name="button_border" left="4" right="4" top="4" bottom="4" />
</frame_geometry>

<frame_geometry name="maximized" parent="normal" rounded_top_left="0" rounded_top_right="0">
  <distance name="left_width" value="0" />
  <distance name="right_width" value="0" />
  <distance name="bottom_height" value="0" />
</frame_geometry>

<!-- ::: DRAW OPS ::: -->
<draw_ops name="draw_frame_focused">
  <rectangle color="C_wm_bg" x="0" y="0" width="width" height="height" filled="true" />
  <line color="C_wm_border" x1="0" y1="height - 1" x2="width" y2="height - 1" width="1" />
</draw_ops>

<draw_ops name="draw_frame_unfocused">
  <rectangle color="C_wm_bg_unfocused" x="0" y="0" width="width" height="height" filled="true" />
  <line color="C_wm_border_unfocused" x1="0" y1="height - 1" x2="width" y2="height - 1" width="1" />
</draw_ops>

<!-- 🔴 Close Button (Traffic Light Red) -->
<draw_ops name="btn_close_normal">
  <arc color="C_btn_close" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="true" />
  <arc color="C_btn_close_border" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="false" />
</draw_ops>

<draw_ops name="btn_close_hover">
  <arc color="C_btn_close_hover" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="true" />
  <!-- Subtle dark 'x' glyph -->
  <line color="#4D0000" x1="6" y1="6" x2="10" y2="10" width="1.2" />
  <line color="#4D0000" x1="10" y1="6" x2="6" y2="10" width="1.2" />
</draw_ops>

<draw_ops name="btn_close_unfocused">
  <arc color="C_btn_unfocused" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="true" />
  <arc color="C_btn_unfocused_border" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="false" />
</draw_ops>

<!-- 🟡 Minimize Button (Traffic Light Yellow) -->
<draw_ops name="btn_min_normal">
  <arc color="C_btn_min" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="true" />
  <arc color="C_btn_min_border" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="false" />
</draw_ops>

<draw_ops name="btn_min_hover">
  <arc color="C_btn_min_hover" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="true" />
  <!-- Subtle dark '-' glyph -->
  <line color="#593B00" x1="5" y1="8" x2="11" y2="8" width="1.2" />
</draw_ops>

<draw_ops name="btn_min_unfocused">
  <arc color="C_btn_unfocused" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="true" />
  <arc color="C_btn_unfocused_border" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="false" />
</draw_ops>

<!-- 🟢 Maximize Button (Traffic Light Green) -->
<draw_ops name="btn_max_normal">
  <arc color="C_btn_max" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="true" />
  <arc color="C_btn_max_border" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="false" />
</draw_ops>

<draw_ops name="btn_max_hover">
  <arc color="C_btn_max_hover" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="true" />
  <!-- Subtle dark '+' / zoom arrows -->
  <line color="#0A4D1A" x1="6" y1="10" x2="10" y2="6" width="1.2" />
</draw_ops>

<draw_ops name="btn_max_unfocused">
  <arc color="C_btn_unfocused" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="true" />
  <arc color="C_btn_unfocused_border" x="2" y="2" width="12" height="12" start_angle="0" extent_angle="360" filled="false" />
</draw_ops>

<!-- ::: FRAME STYLES ::: -->
<frame_style name="focused" geometry="normal">
  <piece position="entire_background" style="draw_frame_focused" />
  <piece position="title" style="draw_frame_focused" />
  <button function="close" state="normal" draw_ops="btn_close_normal" />
  <button function="close" state="prelight" draw_ops="btn_close_hover" />
  <button function="maximize" state="normal" draw_ops="btn_max_normal" />
  <button function="maximize" state="prelight" draw_ops="btn_max_hover" />
  <button function="minimize" state="normal" draw_ops="btn_min_normal" />
  <button function="minimize" state="prelight" draw_ops="btn_min_hover" />
</frame_style>

<frame_style name="unfocused" geometry="normal">
  <piece position="entire_background" style="draw_frame_unfocused" />
  <piece position="title" style="draw_frame_unfocused" />
  <button function="close" state="normal" draw_ops="btn_close_unfocused" />
  <button function="close" state="prelight" draw_ops="btn_close_hover" />
  <button function="maximize" state="normal" draw_ops="btn_max_unfocused" />
  <button function="maximize" state="prelight" draw_ops="btn_max_hover" />
  <button function="minimize" state="normal" draw_ops="btn_min_unfocused" />
  <button function="minimize" state="prelight" draw_ops="btn_min_hover" />
</frame_style>

<frame_style_set name="normal">
  <frame focus="yes" state="normal" resize="both" style="focused" />
  <frame focus="no" state="normal" resize="both" style="unfocused" />
  <frame focus="yes" state="maximized" style="focused" />
  <frame focus="no" state="maximized" style="unfocused" />
</frame_style_set>

<window type="normal" style_set="normal" />
<window type="dialog" style_set="normal" />
<window type="modal_dialog" style_set="normal" />

</metacity_theme>
