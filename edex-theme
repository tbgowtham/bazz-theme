    print(f"{CYAN_BOLD}║  [ eDEX-UI // LIQUID-GAS MEMORY CONDENSATION REACTOR ]           ║{RESET}")
    print(f"{CYAN_BOLD}╚══════════════════════════════════════════════════════════════════╝{RESET}")

    mem_before = psutil.virtual_memory()
    used_mb_before = mem_before.used / (1024 ** 2)

    print(f" {MUTED}• Initial State: {used_mb_before:.1f} MB active memory allocation{RESET}")
    print(f" {CYAN}• Condensing gaseous thread buffers...{RESET}")
    
    frames = [
        "   °   *   ·   *   (gaseous vapor cooling)",
        "     \\   |   /     (molecules contracting)",
        "       ▼   ▼       (phase transition: gas -> liquid)",
        "        [ 💧 ]     (condensed into liquid pool)",
    ]
    for frame in frames:
        time.sleep(0.15)
        print(f"   {CYAN}{frame}{RESET}")

    subprocess.run(["sync"], check=False)

    mem_after = psutil.virtual_memory()
    used_mb_after = mem_after.used / (1024 ** 2)
    saved = max(0.0, used_mb_before - used_mb_after)

    print(f"\n {GREEN_BOLD}✓ Memory Condensation Complete!{RESET}")
    print(f"   Current RAM: {GREEN}{mem_after.percent:.1f}%{RESET} ({used_mb_after:.1f} MB used)")
    print(f"   Reclaimed:   {CYAN_BOLD}{saved:.1f} MB{RESET} of memory cache.\n")

