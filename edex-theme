def print_telemetry_summary():
    uname = platform.uname()
    cpu_percent = psutil.cpu_percent(interval=0.1)
    cpu_cores = psutil.cpu_count(logical=True)
    mem = psutil.virtual_memory()
    disk = psutil.disk_usage('/')
    
    # Active IP
    active_ip = "127.0.0.1"
    active_iface = "wlan0"
    for iface, addrs in psutil.net_if_addrs().items():
        if iface != 'lo':
            for a in addrs:
                if a.family == socket.AF_INET:
                    active_ip = a.address
                    active_iface = iface
                    break
        if active_ip != "127.0.0.1":
            break

    print(f" {CYAN_BOLD}[SYSTEM]{RESET} {BOLD}{uname.node.upper()}{RESET}  •  {CYAN}OS:{RESET} {uname.system} {uname.release} ({uname.machine})")
    print(f" {CYAN_BOLD}[CPU]   {RESET} {GREEN_BOLD}{cpu_percent:.1f}%{RESET} load across {cpu_cores} logical cores")
    print(f" {CYAN_BOLD}[RAM]   {RESET} {GREEN_BOLD}{mem.used/(1024**3):.2f} GB{RESET} / {mem.total/(1024**3):.2f} GB ({mem.percent}%)")
    print(f" {CYAN_BOLD}[DISK]  {RESET} {AMBER}{disk.used/(1024**3):.1f} GB{RESET} / {disk.total/(1024**3):.1f} GB ({disk.percent}%)")
    print(f" {CYAN_BOLD}[NET]   {RESET} {CYAN}{active_iface}{RESET} ({active_ip})  •  DEFENSE GRID: {GREEN}ONLINE{RESET}")
    print(f" {CYAN_BOLD}[STATUS]{RESET} {GREEN_BOLD}eDEX-UI TRON THEME APPLIED ACROSS ENTIRE SYSTEM!{RESET}\n")
    print(f" {MUTED}• Terminal:  Konsole & active window palette set to Neon Cyan / Abyss Navy")
    print(f" • Desktop:   KDE Plasma 6 eDEX-TRON color scheme activated")
    print(f" • Shell:     Interactive prompt [eDEX-UI // TRON] set in ~/.bashrc.d/")
    print(f" • Graphics:  GTK 3/4 & Metacity cyan glow borders configured{RESET}")
    print(f"\n {CYAN}Run {BOLD}'edex --app'{RESET}{CYAN} to launch the interactive live terminal dashboard!{RESET}\n")

def run_tui_monitor():
    """Interactive full-screen live eDEX-UI terminal dashboard."""
    sys.stdout.write('\033[?1049h\033[?25l\033[H\033[2J')
    sys.stdout.flush()

    old_settings = None
    try:
        if sys.stdin.isatty():
            old_settings = termios.tcgetattr(sys.stdin)
            tty.setcbreak(sys.stdin.fileno())

        radar_frames = ["/", "-", "\\", "|"]
        frame_idx = 0

        while True:
            # Check for user input (non-blocking)
            if sys.stdin.isatty():
                r, _, _ = select.select([sys.stdin], [], [], 0.8)
                if r:
                    ch = sys.stdin.read(1)
                    if ch in ['q', 'Q', '\x03', '\x1b']: # q, Q, Ctrl+C, Esc
                        break
            else:
                time.sleep(0.8)

            uname = platform.uname()
            cpu_p = psutil.cpu_percent(interval=None)
            cores = psutil.cpu_percent(interval=None, percpu=True)
            mem = psutil.virtual_memory()
            swap = psutil.swap_memory()
            disk = psutil.disk_usage('/')
            net = psutil.net_io_counters()
            time_str = time.strftime("%H:%M:%S UTC")
            uptime = int(time.time() - psutil.boot_time())
            up_h = uptime // 3600
            up_m = (uptime % 3600) // 60
            radar_char = radar_frames[frame_idx % len(radar_frames)]
            frame_idx += 1

            buf = []
            buf.append('\033[H') # Move cursor to top-left
            buf.append(f"{CYAN_BOLD}╔══════════════════════════════════════════════════════════════════════════════════════╗{RESET}\n")
            buf.append(f"{CYAN_BOLD}║  eDEX-UI v3.2.0 // TRON LEGACY TERMINAL DASHBOARD                    [ {time_str} ] ║{RESET}\n")
            buf.append(f"{CYAN_BOLD}║  NODE: {uname.node.upper():<12} ARCH: {uname.machine:<8} KERNEL: {uname.release[:18]:<18} UPTIME: {up_h}h {up_m}m  ║{RESET}\n")
            buf.append(f"{CYAN_BOLD}╠══════════════════════════════════════════╦═══════════════════════════════════════════╣{RESET}\n")
            buf.append(f"{CYAN_BOLD}║  [ CPU TELEMETRY & CORES ]               ║  [ GEO-RADAR & TELEMETRY SCANNER ]        ║{RESET}\n")
            
            # CPU Total Bar
            cpu_bars = int(cpu_p / 100.0 * 20)
            cpu_vis = "█" * cpu_bars + "░" * (20 - cpu_bars)
            buf.append(f"{CYAN_BOLD}║{RESET}  Total: {GREEN_BOLD}{cpu_p:5.1f}%{RESET} [{CYAN}{cpu_vis}{RESET}]  {CYAN_BOLD}║{RESET}  Scanner: [ {GREEN_BOLD}{radar_char}{RESET} ] Status: {GREEN}SWEEPING ONLINE{RESET}    {CYAN_BOLD}║{RESET}\n")
            
            # Cores row by row
            cores_to_show = min(8, len(cores))
            for i in range(0, cores_to_show, 2):
                c1_p = cores[i]
                c1_bar = "█" * int(c1_p / 100.0 * 6) + "░" * (6 - int(c1_p / 100.0 * 6))
                if i + 1 < cores_to_show:
                    c2_p = cores[i + 1]
                    c2_bar = "█" * int(c2_p / 100.0 * 6) + "░" * (6 - int(c2_p / 100.0 * 6))
                    left_text = f"C{i}:{c1_p:2.0f}%[{c1_bar}] C{i+1}:{c2_p:2.0f}%[{c2_bar}]"
                else:
                    left_text = f"C{i}:{c1_p:2.0f}%[{c1_bar}]            "

                if i == 0:
                    right_text = f"Azimuth: 142.5°  Grid: 37.77N 122.41W"
                elif i == 2:
                    right_text = f"Net RX: {net.bytes_recv/(1024**2):.1f} MB  TX: {net.bytes_sent/(1024**2):.1f} MB"
                elif i == 4:
                    right_text = f"Root [/]: {disk.used/(1024**3):.1f}G / {disk.total/(1024**3):.1f}G ({disk.percent}%)"
                else:
                    right_text = f"Ping: 12ms  Target Blips: 3 Locked"

                buf.append(f"{CYAN_BOLD}║{RESET}  {left_text:<38}  {CYAN_BOLD}║{RESET}  {right_text:<39}  {CYAN_BOLD}║{RESET}\n")

            buf.append(f"{CYAN_BOLD}╠══════════════════════════════════════════╬═══════════════════════════════════════════╣{RESET}\n")
            buf.append(f"{CYAN_BOLD}║  [ MEMORY & STORAGE ALLOCATION ]         ║  [ ACTIVE CONSUMPTION PROCESSES ]         ║{RESET}\n")

            # RAM bar
            ram_bars = int(mem.percent / 100.0 * 16)
            ram_vis = "█" * ram_bars + "░" * (16 - ram_bars)
            buf.append(f"{CYAN_BOLD}║{RESET}  RAM:  {GREEN_BOLD}{mem.percent:4.1f}%{RESET} [{GREEN}{ram_vis}{RESET}] {mem.used/(1024**3):.1f}G/{mem.total/(1024**3):.1f}G{CYAN_BOLD}║{RESET}")
            
            # Top process 1
            procs = sorted(
                psutil.process_iter(['name', 'cpu_percent', 'memory_percent']),
                key=lambda p: (p.info.get('cpu_percent') or 0) + (p.info.get('memory_percent') or 0),
                reverse=True
            )[:3]

            p1_str = f"• {procs[0].info['name'][:14]:<14} C:{procs[0].info['cpu_percent']:.0f}% M:{procs[0].info['memory_percent']:.1f}%" if len(procs) > 0 else "• None"
            buf.append(f"  {p1_str:<39}  {CYAN_BOLD}║{RESET}\n")

            # Swap bar
            swap_bars = int(swap.percent / 100.0 * 16)
            swap_vis = "█" * swap_bars + "░" * (16 - swap_bars)
            buf.append(f"{CYAN_BOLD}║{RESET}  SWAP: {AMBER}{swap.percent:4.1f}%{RESET} [{AMBER}{swap_vis}{RESET}] {swap.used/(1024**3):.1f}G/{swap.total/(1024**3):.1f}G{CYAN_BOLD}║{RESET}")
            
            p2_str = f"• {procs[1].info['name'][:14]:<14} C:{procs[1].info['cpu_percent']:.0f}% M:{procs[1].info['memory_percent']:.1f}%" if len(procs) > 1 else "• None"
            buf.append(f"  {p2_str:<39}  {CYAN_BOLD}║{RESET}\n")

            # Disk bar
            disk_bars = int(disk.percent / 100.0 * 16)
            disk_vis = "█" * disk_bars + "░" * (16 - disk_bars)
            buf.append(f"{CYAN_BOLD}║{RESET}  DISK: {CYAN}{disk.percent:4.1f}%{RESET} [{CYAN}{disk_vis}{RESET}] {disk.used/(1024**3):.1f}G/{disk.total/(1024**3):.1f}G{CYAN_BOLD}║{RESET}")

            p3_str = f"• {procs[2].info['name'][:14]:<14} C:{procs[2].info['cpu_percent']:.0f}% M:{procs[2].info['memory_percent']:.1f}%" if len(procs) > 2 else "• None"
            buf.append(f"  {p3_str:<39}  {CYAN_BOLD}║{RESET}\n")

            buf.append(f"{CYAN_BOLD}╚══════════════════════════════════════════╩═══════════════════════════════════════════╝{RESET}\n")
            buf.append(f" {CYAN_BOLD}[COMMANDS]{RESET} {BOLD}[Q]{RESET} Exit Monitor   {GREEN}DEFENSE GRID: LEVEL 7 ONLINE{RESET}\n")

            sys.stdout.write("".join(buf))
            sys.stdout.flush()

    finally:
        if old_settings and sys.stdin.isatty():
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
        sys.stdout.write('\033[?25h\033[?1049l')
        sys.stdout.flush()

def restore_defaults():
    """Restore default desktop settings."""
    print(f"{AMBER}Restoring standard desktop theme settings...{RESET}")
    
    # Remove bashrc.d script
    bash_script = os.path.join(BASHRC_D, "edex-theme.sh")
    if os.path.exists(bash_script):
        os.remove(bash_script)
        
    if shutil.which("plasma-apply-colorscheme"):
        try:
            subprocess.run(["plasma-apply-colorscheme", "BreezeDark"], check=False)
        except Exception:
            pass

    if shutil.which("gsettings"):
        for cmd in [
            ["gsettings", "set", "org.cinnamon.theme", "name", "Mint-Y"],
            ["gsettings", "set", "org.cinnamon.desktop.interface", "gtk-theme", "Mint-Y"],
            ["gsettings", "set", "org.cinnamon.desktop.interface", "icon-theme", "Mint-Y"],
        ]:
            try:
                subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
    print(f"{GREEN}✓ Restored default desktop settings.{RESET}")

def main():
    parser = argparse.ArgumentParser(description="eDEX-UI // TRON System-Wide Theme Command")
    parser.add_argument("--app", "--tui", "--monitor", action="store_true", dest="app", help="Launch interactive live terminal monitor")
    parser.add_argument("--status", action="store_true", help="Display telemetry and theme status")
    parser.add_argument("--restore", action="store_true", help="Restore default desktop theme")
    args = parser.parse_args()

    if args.status:
        print_banner()
        print_telemetry_summary()
        return

    if args.restore:
        restore_defaults()
        return

    # Default action: Apply the COMPLETE eDEX-UI System Theme!
    apply_terminal_palette()
    play_chime()
    print_banner()
    
    print(f"{CYAN}[1/4] Configuring Terminal & Shell Environment...{RESET}")
    install_konsole_profile()
    install_shell_env()
    
    print(f"{CYAN}[2/4] Applying KDE Plasma 6 TRON Color Scheme...{RESET}")
    install_kde_colors()
    
    print(f"{CYAN}[3/4] Installing GTK & Icon Themes...{RESET}")
    install_desktop_themes()
    
    print(f"{CYAN}[4/4] Activating Theme Engine...{RESET}")
    print_telemetry_summary()

    # If --app was passed, start the interactive monitor immediately
    if args.app:
        time.sleep(1)
        run_tui_monitor()

if __name__ == "__main__":
    main()
