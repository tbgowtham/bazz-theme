#!/usr/bin/env python3
"""
==============================================================================
eDEX-UI // TRON SYSTEM-WIDE THEME & TERMINAL CONTROLLER
==============================================================================
A single terminal command that transforms your Linux desktop environment
into the authentic eDEX-UI / TRON: Legacy sci-fi interface.

Features:
- KDE Plasma 6 TRON Colorscheme (eDEX-TRON)
- Konsole Terminal Profile & Colorscheme (eDEX-TRON)
- Active Terminal OSC Truecolor Palette Shift
- Interactive Bash Shell Prompt ([eDEX-UI // TRON])
- GTK 3 / 4 & Window Decorations
- Minimalist Vector Icon Theme
- Audio Chime Feedback
- Optional Interactive Live TUI Dashboard (`edex --app`)
==============================================================================
"""

import os
import sys
import time
import select
import socket
import termios
import tty
import argparse
import platform
import subprocess
import shutil
import psutil

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
TOOLS_DIR = os.path.join(SCRIPT_DIR, "tools")
ASSETS_DIR = os.path.join(SCRIPT_DIR, "assets")
CHIME_PATH = os.path.join(ASSETS_DIR, "edex_chime.wav")

# Destination Paths
HOME = os.path.expanduser("~")
KDE_SCHEMES_DIR = os.path.join(HOME, ".local/share/color-schemes")
KONSOLE_DIR = os.path.join(HOME, ".local/share/konsole")
BASHRC_D = os.path.join(HOME, ".bashrc.d")
THEME_DEST = os.path.join(HOME, ".themes/Jarvis-Windows11-Shell")
ICON_DEST = os.path.join(HOME, ".icons/Jarvis-White")
ICON_DEST_LOCAL = os.path.join(HOME, ".local/share/icons/Jarvis-White")

# ANSI Color Codes
CYAN = '\033[38;2;0;229;255m'
CYAN_BOLD = '\033[1;38;2;0;229;255m'
GREEN = '\033[38;2;0;255;136m'
GREEN_BOLD = '\033[1;38;2;0;255;136m'
AMBER = '\033[38;2;255;183;3m'
RED = '\033[38;2;255;42;95m'
MUTED = '\033[38;2;130;160;190m'
BOLD = '\033[1m'
RESET = '\033[0m'

def apply_terminal_palette():
    """Dynamically set the palette of the currently active terminal window."""
    try:
        # OSC 10: Foreground color (Neon Cyan #00e5ff)
        # OSC 11: Background color (Abyss Navy #000b1e)
        # OSC 12: Cursor color (Neon Cyan #00e5ff)
        sys.stdout.write('\033]10;#00e5ff\a')
        sys.stdout.write('\033]11;#000b1e\a')
        sys.stdout.write('\033]12;#00e5ff\a')
        # OSC 4: 16-color ANSI palette mapping
        sys.stdout.write('\033]4;0;#000b1e;1;#ff2a5f;2;#00ff88;3;#ffb703;4;#00b4ff;5;#b446ff;6;#00e5ff;7;#cbd5e1;8;#142846;9;#ff5078;10;#32ffa0;11;#ffd23c;12;#00e5ff;13;#d278ff;14;#50f0ff;15;#ffffff\a')
        sys.stdout.flush()
    except Exception:
        pass

def play_chime():
    """Play futuristic Tron electronic activation sound."""
    if os.path.exists(CHIME_PATH):
        for player in ["paplay", "pw-play", "aplay"]:
            if shutil.which(player):
                try:
                    subprocess.Popen([player, CHIME_PATH], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    break
                except Exception:
                    pass

def install_kde_colors():
    """Install and activate eDEX-TRON color scheme in KDE Plasma 6."""
    os.makedirs(KDE_SCHEMES_DIR, exist_ok=True)
    src = os.path.join(TOOLS_DIR, "eDEX-TRON.colors")
    dst = os.path.join(KDE_SCHEMES_DIR, "eDEX-TRON.colors")
    if os.path.exists(src):
        shutil.copyfile(src, dst)

    if shutil.which("plasma-apply-colorscheme"):
        try:
            res = subprocess.run(["plasma-apply-colorscheme", "eDEX-TRON"], capture_output=True, text=True)
            return res.returncode == 0
        except Exception:
            pass
    return False

def install_konsole_profile():
    """Install and set eDEX-TRON profile for KDE Konsole."""
    os.makedirs(KONSOLE_DIR, exist_ok=True)
    scheme_src = os.path.join(TOOLS_DIR, "eDEX-TRON.colorscheme")
    profile_src = os.path.join(TOOLS_DIR, "eDEX-TRON.profile")

    if os.path.exists(scheme_src):
        shutil.copyfile(scheme_src, os.path.join(KONSOLE_DIR, "eDEX-TRON.colorscheme"))
    if os.path.exists(profile_src):
        shutil.copyfile(profile_src, os.path.join(KONSOLE_DIR, "eDEX-TRON.profile"))

    if shutil.which("kwriteconfig6"):
        try:
            konsolerc = os.path.expanduser("~/.config/konsolerc")
            subprocess.run([
                "kwriteconfig6", "--file", konsolerc,
                "--group", "Desktop Entry",
                "--key", "DefaultProfile", "eDEX-TRON.profile"
            ], check=False)
        except Exception:
            pass

def install_shell_env():
    """Configure eDEX-UI bash environment and prompt."""
    os.makedirs(BASHRC_D, exist_ok=True)
    src = os.path.join(TOOLS_DIR, "edex-theme.sh")
    dst = os.path.join(BASHRC_D, "edex-theme.sh")
    if os.path.exists(src):
        shutil.copyfile(src, dst)
        os.chmod(dst, 0o755)

def install_desktop_themes():
    """Install GTK and icon themes and apply via GSettings."""
    os.makedirs(os.path.join(THEME_DEST, "gtk-3.0"), exist_ok=True)
    os.makedirs(os.path.join(THEME_DEST, "gtk-4.0"), exist_ok=True)
    os.makedirs(os.path.join(THEME_DEST, "metacity-1"), exist_ok=True)
    os.makedirs(ICON_DEST, exist_ok=True)
    os.makedirs(ICON_DEST_LOCAL, exist_ok=True)

    # Copy GTK & Metacity themes
    for sub in ["gtk-3.0", "gtk-4.0", "metacity-1", "cinnamon"]:
        src_dir = os.path.join(SCRIPT_DIR, sub)
        dst_dir = os.path.join(THEME_DEST, sub)
        if os.path.exists(src_dir):
            shutil.copytree(src_dir, dst_dir, dirs_exist_ok=True)

    # Copy Icons
    icon_src = os.path.join(SCRIPT_DIR, "icons/Jarvis-White")
    if os.path.exists(icon_src):
        shutil.copytree(icon_src, ICON_DEST, dirs_exist_ok=True)
        shutil.copytree(icon_src, ICON_DEST_LOCAL, dirs_exist_ok=True)

    if shutil.which("gsettings"):
        for cmd in [
            ["gsettings", "set", "org.cinnamon.theme", "name", "Jarvis-Windows11-Shell"],
            ["gsettings", "set", "org.cinnamon.desktop.interface", "gtk-theme", "Jarvis-Windows11-Shell"],
            ["gsettings", "set", "org.cinnamon.desktop.interface", "icon-theme", "Jarvis-White"],
            ["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Jarvis-Windows11-Shell"],
            ["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", "Jarvis-White"],
        ]:
            try:
                subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass

