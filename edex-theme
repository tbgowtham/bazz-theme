                    left_text = f"C{i}:{c1_p:2.0f}%[{c1_bar}] C{i+1}:{c2_p:2.0f}%[{c2_bar}]"
                else:
                    left_text = f"C{i}:{c1_p:2.0f}%[{c1_bar}]            "

                if i == 0:
                    right_text = f"Azimuth: 142.5°  Grid: 37.77N 122.41W"
                elif i == 2:
                    right_text = f"Net RX: {net.bytes_recv/(1024**2):.1f} MB  TX: {net.bytes_sent/(1024**2):.1f} MB"
                elif i == 4:
                    right_text = f"Root [/]: {disk.used/(1024**3):.1f}G / {disk.total/(1024**3):.1f}G ({disk.percent}%)"
                else:
                    right_text = f"Ping: 12ms  Target Blips: 3 Locked"

                buf.append(f"{CYAN_BOLD}║{RESET}  {left_text:<38}  {CYAN_BOLD}║{RESET}  {right_text:<39}  {CYAN_BOLD}║{RESET}\n")

            buf.append(f"{CYAN_BOLD}╠══════════════════════════════════════════╬═══════════════════════════════════════════╣{RESET}\n")
            buf.append(f"{CYAN_BOLD}║  [ MEMORY ALLOCATION & SWAP ]            ║  [ ACTIVE CONSUMPTION PROCESSES ]         ║{RESET}\n")

            ram_bars = int(mem.percent / 100.0 * 16)
            ram_vis = "█" * ram_bars + "░" * (16 - ram_bars)
            buf.append(f"{CYAN_BOLD}║{RESET}  RAM:  {GREEN_BOLD}{mem.percent:4.1f}%{RESET} [{GREEN}{ram_vis}{RESET}] {mem.used/(1024**3):.1f}G/{mem.total/(1024**3):.1f}G{CYAN_BOLD}║{RESET}")
            
            procs = sorted(
                psutil.process_iter(['name', 'cpu_percent', 'memory_percent']),
                key=lambda p: (p.info.get('cpu_percent') or 0) + (p.info.get('memory_percent') or 0),
                reverse=True
            )[:3]

            p1_str = f"• {procs[0].info['name'][:14]:<14} C:{procs[0].info['cpu_percent']:.0f}% M:{procs[0].info['memory_percent']:.1f}%" if len(procs) > 0 else "• None"
            buf.append(f"  {p1_str:<39}  {CYAN_BOLD}║{RESET}\n")

            swap_bars = int(swap.percent / 100.0 * 16)
            swap_vis = "█" * swap_bars + "░" * (16 - swap_bars)
            buf.append(f"{CYAN_BOLD}║{RESET}  SWAP: {AMBER}{swap.percent:4.1f}%{RESET} [{AMBER}{swap_vis}{RESET}] {swap.used/(1024**3):.1f}G/{swap.total/(1024**3):.1f}G{CYAN_BOLD}║{RESET}")
            
            p2_str = f"• {procs[1].info['name'][:14]:<14} C:{procs[1].info['cpu_percent']:.0f}% M:{procs[1].info['memory_percent']:.1f}%" if len(procs) > 1 else "• None"
            buf.append(f"  {p2_str:<39}  {CYAN_BOLD}║{RESET}\n")

            disk_bars = int(disk.percent / 100.0 * 16)
            disk_vis = "█" * disk_bars + "░" * (16 - disk_bars)
            buf.append(f"{CYAN_BOLD}║{RESET}  DISK: {CYAN}{disk.percent:4.1f}%{RESET} [{CYAN}{disk_vis}{RESET}] {disk.used/(1024**3):.1f}G/{disk.total/(1024**3):.1f}G{CYAN_BOLD}║{RESET}")

            p3_str = f"• {procs[2].info['name'][:14]:<14} C:{procs[2].info['cpu_percent']:.0f}% M:{procs[2].info['memory_percent']:.1f}%" if len(procs) > 2 else "• None"
            buf.append(f"  {p3_str:<39}  {CYAN_BOLD}║{RESET}\n")

            buf.append(f"{CYAN_BOLD}╚══════════════════════════════════════════╩═══════════════════════════════════════════╝{RESET}\n")
            buf.append(f" {CYAN_BOLD}[COMMANDS]{RESET} {BOLD}[Q]{RESET} Exit Cockpit   {GREEN}DEFENSE GRID: LEVEL 9 ONLINE{RESET}\n")

            sys.stdout.write("".join(buf))
            sys.stdout.flush()

    finally:
        if old_settings and sys.stdin.isatty():
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
        sys.stdout.write('\033[?25h\033[?1049l')
        sys.stdout.flush()

def restore_defaults():
    """Restore default desktop settings."""
    print(f"{AMBER}Restoring standard desktop theme settings...{RESET}")
    
    bash_script = os.path.join(BASHRC_D, "edex-theme.sh")
    if os.path.exists(bash_script):
        os.remove(bash_script)
        
    if shutil.which("plasma-apply-colorscheme"):
        try:
            subprocess.run(["plasma-apply-colorscheme", "BreezeDark"], check=False)
        except Exception:
            pass

    if shutil.which("gsettings"):
        for cmd in [
            ["gsettings", "set", "org.cinnamon.theme", "name", "Mint-Y"],
            ["gsettings", "set", "org.cinnamon.desktop.interface", "gtk-theme", "Mint-Y"],
            ["gsettings", "set", "org.cinnamon.desktop.interface", "icon-theme", "Mint-Y"],
        ]:
            try:
                subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
    print(f"{GREEN}✓ Restored default desktop settings.{RESET}")

def main():
    parser = argparse.ArgumentParser(description="eDEX-UI // Cybernetic Mecha System Controller")
    parser.add_argument("action", nargs="?", default=None, help="Action: lock, mecha, auto, diag, scan, fluid, condense, phase, status, restore")
    parser.add_argument("param", nargs="?", default=None, help="Parameter for action (e.g. phase state name or --daemon)")
    parser.add_argument("--lock", action="store_true", help="Launch fullscreen robotic screen locker")
    parser.add_argument("--auto", "--adaptive", action="store_true", dest="auto", help="Run AI adaptive matter engine (auto-shifts theme by compute load)")
    parser.add_argument("--daemon", action="store_true", help="Run adaptive engine in continuous daemon loop")
    parser.add_argument("--mecha", action="store_true", help="Activate Titanium Mecha Robotic state")
    parser.add_argument("--diag", "--scan", action="store_true", dest="diag", help="Run robotic mecha hardware diagnostic")
    parser.add_argument("--fluid", action="store_true", help="Launch interactive 2D fluid dynamics reactor")
    parser.add_argument("--condense", action="store_true", help="Run memory condensation & cache purge")
    parser.add_argument("--phase", type=str, default=None, help="Shift matter state: mecha, cryo, plasma, mercury, solar")
    parser.add_argument("--app", "--tui", "--monitor", action="store_true", dest="app", help="Launch interactive live terminal cockpit")
    parser.add_argument("--status", action="store_true", help="Display telemetry and theme status")
    parser.add_argument("--restore", action="store_true", help="Restore default desktop theme")
    args = parser.parse_args()

    action = (args.action or "").lower()

    if action == "lock" or args.lock:
        subprocess.run([sys.executable, ROBOTIC_LOCK])
        return

    if action in ["auto", "adaptive"] or args.auto:
        is_daemon = args.daemon or (args.param == "--daemon")
        run_adaptive_ai(daemon=is_daemon)
        return

    if action in ["diag", "scan"] or args.diag:
        subprocess.run([sys.executable, MECHA_DIAG])
        return

    if action == "mecha" or args.mecha:
        set_matter_phase("mecha")
        return

    if action == "fluid" or args.fluid:
        phase_to_use = args.param or "cryo"
        subprocess.run([sys.executable, FLUID_REACTOR, phase_to_use])
        return

    if action == "condense" or args.condense:
        run_condenser()
        return

    if action == "phase" or args.phase:
        phase_target = args.param or args.phase or "mecha"
        set_matter_phase(phase_target)
        return

    if action == "status" or args.status:
        print_banner()
        print_telemetry_summary()
        return

    if action == "restore" or args.restore:
        restore_defaults()
        return

    if action in ["app", "tui"] or args.app:
        run_tui_monitor()
        return

    # Default action: Apply the COMPLETE Cybernetic Mecha System Theme!
    apply_terminal_palette(fg_hex='#00f0ff', bg_hex='#070a10')
    print_banner()
    
    print(f"{CYAN}[1/4] Configuring Cybernetic Mecha Shell & Terminal...{RESET}")
    install_konsole_profile("eDEX-TRON-Mecha")
    install_shell_env(prompt_icon="⚙ MECHA-ROBOTIC ⚙", fg_hex="#00f0ff", bg_hex="#070a10")
    
    print(f"{CYAN}[2/4] Applying KDE Plasma 6 Mecha Robotic Color Scheme...{RESET}")
    install_kde_colors("eDEX-TRON-Mecha")
    
    print(f"{CYAN}[3/4] Configuring Robotic Lock Screen & Defense Security Grid...{RESET}")
    configure_kde_lockscreen("eDEX-TRON-Mecha")
    
    print(f"{CYAN}[4/4] Installing Fluid Mecha GTK 3/4 & Metacity Themes...{RESET}")
    install_desktop_themes()
    
    print_telemetry_summary()

if __name__ == "__main__":
    main()
