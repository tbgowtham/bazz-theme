def set_matter_phase(phase_name, silent=False):
    """Shift matter state across KDE, lockscreen, terminal palette, and shell prompt."""
    phase_key = phase_name.lower().strip()
    if phase_key not in PHASE_CONFIGS:
        if not silent:
            print(f"{AMBER}Unknown phase '{phase_name}'. Available: mecha, cryo, plasma, mercury, solar{RESET}")
        return

    cfg = PHASE_CONFIGS[phase_key]
    pri_col = cfg['rgb_pri']
    if not silent:
        print(f"\n{pri_col}≋≋≋ INITIATING MATTER PHASE TRANSITION -> {cfg['name']} ≋≋≋{RESET}")
        print(f" {MUTED}• {cfg['desc']}{RESET}")

    # 1. Terminal OSC Shift
    apply_terminal_palette(cfg['fg_hex'], cfg['bg_hex'])
    
    # 2. KDE Plasma 6 Color Scheme
    install_kde_colors(cfg['scheme'])
    configure_kde_lockscreen(cfg['scheme'])
    
    # 3. Konsole Profile
    install_konsole_profile(cfg['scheme'])
    
    # 4. Shell Prompt
    install_shell_env(prompt_icon=cfg['prompt_icon'], fg_hex=cfg['fg_hex'], bg_hex=cfg['bg_hex'])
    
    if not silent:
        print(f"{GREEN_BOLD}✓ Matter phase shifted to {cfg['name']} successfully!{RESET}\n")

def run_adaptive_ai(daemon=False):
    """AI Adaptive Matter Engine: Dynamically shifts desktop phase based on compute pressure."""
    print(f"\n{CYAN_BOLD}╔══════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{CYAN_BOLD}║  [ eDEX-UI // AI ADAPTIVE COMPUTE PRESSURE MONITOR ]             ║{RESET}")
    print(f"{CYAN_BOLD}╚══════════════════════════════════════════════════════════════════╝{RESET}")

    def evaluate_state():
        cpu_p = psutil.cpu_percent(interval=0.5)
        # Check thermal temp if available
        temp = 45.0
        try:
            temps = psutil.sensors_temperatures()
            if 'coretemp' in temps and temps['coretemp']:
                temp = temps['coretemp'][0].current
        except Exception:
            pass

        if temp > 75.0 or cpu_p > 85.0:
            target = "solar"
        elif cpu_p > 60.0:
            target = "plasma"
        elif cpu_p > 25.0:
            target = "mecha"
        else:
            target = "cryo"

        return target, cpu_p, temp

    target_phase, cpu, t = evaluate_state()
    print(f" {CYAN_BOLD}► SENSOR ANALYSIS:{RESET} CPU Load: {GREEN}{cpu:.1f}%{RESET}  •  Core Temp: {AMBER}{t:.1f}°C{RESET}")
    print(f" {CYAN_BOLD}► AI CLASSIFICATION:{RESET} Workload demands phase -> {BOLD}{PHASE_CONFIGS[target_phase]['name']}{RESET}")
    set_matter_phase(target_phase, silent=False)

    if daemon:
        print(f"{MUTED}Starting continuous adaptive monitoring (Ctrl+C to stop)...{RESET}")
        current_active = target_phase
        try:
            while True:
                time.sleep(3.0)
                new_phase, c, tm = evaluate_state()
                if new_phase != current_active:
                    current_active = new_phase
                    print(f"[{time.strftime('%H:%M:%S')}] {CYAN}Load shift ({c:.1f}% / {tm:.1f}°C) -> Shifting to {PHASE_CONFIGS[new_phase]['name']}{RESET}")
                    set_matter_phase(new_phase, silent=True)
        except KeyboardInterrupt:
            print(f"\n{MUTED}Adaptive daemon halted.{RESET}")

