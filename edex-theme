def apply_terminal_palette(fg_hex='#00f0ff', bg_hex='#070a10'):
    """Dynamically set the palette of the currently active terminal window."""
    try:
        sys.stdout.write(f'\033]10;{fg_hex}\a')
        sys.stdout.write(f'\033]11;{bg_hex}\a')
        sys.stdout.write(f'\033]12;{fg_hex}\a')
        sys.stdout.flush()
    except Exception:
        pass

def install_kde_colors(scheme_name='eDEX-TRON-Mecha'):
    """Install and activate matter phase color scheme in KDE Plasma 6."""
    os.makedirs(KDE_SCHEMES_DIR, exist_ok=True)
    src = os.path.join(TOOLS_DIR, f"{scheme_name}.colors")
    if not os.path.exists(src):
        src = os.path.join(TOOLS_DIR, "eDEX-TRON-Mecha.colors")
    dst = os.path.join(KDE_SCHEMES_DIR, os.path.basename(src))
    if os.path.exists(src):
        shutil.copyfile(src, dst)

    if shutil.which("plasma-apply-colorscheme"):
        try:
            res = subprocess.run(["plasma-apply-colorscheme", scheme_name], capture_output=True, text=True)
            return res.returncode == 0
        except Exception:
            pass
    return False

def configure_kde_lockscreen(scheme_name='eDEX-TRON-Mecha'):
    """Ensure KDE Plasma screen locker adopts futuristic robotic styling."""
    if shutil.which("kwriteconfig6"):
        try:
            subprocess.run(["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Daemon", "--key", "Autolock", "true"], check=False)
            subprocess.run(["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Daemon", "--key", "LockOnResume", "true"], check=False)
            subprocess.run(["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Daemon", "--key", "Timeout", "15"], check=False)
        except Exception:
            pass

def install_konsole_profile(scheme_name='eDEX-TRON-Mecha'):
    """Install and set profile for KDE Konsole."""
    os.makedirs(KONSOLE_DIR, exist_ok=True)
    scheme_src = os.path.join(TOOLS_DIR, f"{scheme_name}.colorscheme")
    if not os.path.exists(scheme_src):
        scheme_src = os.path.join(TOOLS_DIR, "eDEX-TRON-Mecha.colorscheme")

    if os.path.exists(scheme_src):
        shutil.copyfile(scheme_src, os.path.join(KONSOLE_DIR, f"{scheme_name}.colorscheme"))

    if shutil.which("kwriteconfig6"):
        try:
            konsolerc = os.path.expanduser("~/.config/konsolerc")
            subprocess.run([
                "kwriteconfig6", "--file", konsolerc,
                "--group", "Desktop Entry",
                "--key", "DefaultProfile", f"{scheme_name}.profile"
            ], check=False)
        except Exception:
            pass

